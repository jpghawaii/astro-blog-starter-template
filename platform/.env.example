# Copy to .env.local (never commit). All credentials stay server-side.
DATABASE_URL=postgres://jpg:CHANGE_ME@localhost:5432/jpg_analytics
TEST_DATABASE_URL=postgres://jpg:CHANGE_ME@localhost:5432/jpg_analytics_test
# Session cookie signing/pepper (32+ random chars): openssl rand -hex 32
SESSION_SECRET=
# Set to 1 only on a sandbox database to allow loading/showing the labelled demo dataset.
ALLOW_DEMO_DATA=0

# ---- Public data ----
# Free key: https://api.census.gov/data/key_signup.html (ACS adapter is disabled without it)
CENSUS_API_KEY=

# ---- Internal systems (read-only) ----
# monday.com API token (Admin > Developers > My access tokens). Read scopes only.
MONDAY_API_TOKEN=
MONDAY_SALES_BOARD_ID=18432141829
# QuickBooks Online (Intuit developer app, OAuth2, accounting read scope)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
# Google service account JSON path with read access to the Master Inventory sheet
GOOGLE_APPLICATION_CREDENTIALS=
MASTER_INVENTORY_SHEET_ID=
# GA4 Data API property id (service account above needs Viewer on the property)
GA4_PROPERTY_ID=

# ---- Commercial providers (leave blank until contracted) ----
APOLLO_API_KEY=
PLACER_API_KEY=
REVEAL_MOBILE_API_KEY=
AZIRA_API_KEY=
AUDIENCELAB_API_KEY=
# Mastercard: licensed file delivery only (no key here); drop exports into data/private/imports/mastercard/
